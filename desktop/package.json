{
  "name": "teos-desktop",
  "version": "4.0.0",
  "description": "TEOS Sovereign Sentinel Desktop — SOC Dashboard + Tray Monitor + Scan Engine",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build": "electron-builder",
    "pack": "electron-builder --dir",
    "postinstall": "node -e \"try{require('electron-rebuild')()}catch(e){}\""
  },
  "build": {
    "appId": "com.teos.sentinel",
    "productName": "TEOS Sovereign Sentinel",
    "directories": { "output": "dist" },
    "files": [ "main.js", "preload.js", "../*.html", "../public/*.html" ],
    "win": { "target": "nsis" },
    "mac": { "target": "dmg" },
    "linux": { "target": "AppImage" }
  },
  "devDependencies": {
    "electron": "^42.0.0"
  },
  "overrides": {
    "semver": "7.6.3",
    "@electron/get": {
      "got": "11.8.6",
      "semver": "7.6.3"
    }
  }
}
